# Supabase (API keys nuevas: publishable/secret, no las legacy anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (envío de correos, ver PRD sección 9)
RESEND_API_KEY=

# Secreto que verifica que /api/cron/semanal lo llamó Vercel Cron y no un
# tercero (Vercel manda "Authorization: Bearer <CRON_SECRET>"). Generar un
# valor aleatorio y configurarlo igual en Vercel (Settings → Environment
# Variables) — no hace falta que coincida con ningún otro secreto.
CRON_SECRET=
